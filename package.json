{
  "name": "chess-battle-simulator",
  "version": "0.4.1",
  "private": true,
  "description": "Buy-your-army chess: spend a fixed budget on pieces, place them, then checkmate the enemy AI. Browser game prototype with playtest telemetry.",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:cov": "node --test --experimental-test-coverage tests/*.test.js",
    "test:e2e": "node --test e2e/smoke.test.mjs",
    "build": "node tools/build.mjs",
    "sim": "node tools/simulate.mjs",
    "telemetry:pull": "node tools/pull-telemetry.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "chess.js": "1.4.0",
    "playwright-core": "^1.63.0"
  }
}
